# FinMate Environment Configuration Template
#
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
#
# Usage: These variables can be loaded at build time using --dart-define
# Example: flutter run --dart-define=ENVIRONMENT=development

# Environment
ENVIRONMENT=development

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Banking Integration (Phase 2)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# AI Integration
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payment Integration (Stripe)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Price IDs (create in Stripe Dashboard under Products)
STRIPE_MONTHLY_PRICE_ID=price_monthly_xxx
STRIPE_ANNUAL_PRICE_ID=price_annual_xxx

# Stripe Webhook Secret (for Supabase Edge Functions)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Feature Flags
ENABLE_BIOMETRIC_AUTH=true
ENABLE_AI_INSIGHTS=true
ENABLE_BANK_SYNC=false

# Analytics (Optional)
POSTHOG_API_KEY=
AMPLITUDE_API_KEY=

# Error Tracking (Sentry)
# Get your DSN from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# Format: https://xxxxx@oXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=1.0.0+1
